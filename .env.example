DATABASE_URL=sqlite:///./negotiation.db
SECRET_KEY=
SERVICE_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
GROQ_REQUESTS_PER_MINUTE=10
REDIS_URL=redis://127.0.0.1:6379/0
TWIN_GRPC_TARGET=127.0.0.1:50051
ANALYSIS_GRPC_TARGET=127.0.0.1:50052
EVENT_GRPC_TARGET=127.0.0.1:50053
GRPC_TIMEOUT_SECONDS=40
GRPC_TLS_CA=
GRPC_TLS_CERT=
GRPC_TLS_KEY=
CORS_ORIGINS=http://localhost:4200

# Groq is the default. Set local only for explicit self-hosted inference.
AI_PROVIDER=groq
# Optional self-hosted endpoint. Never expose it directly to the browser.
AI_BASE_URL=http://127.0.0.1:8090/v1
AI_MODEL=negotiation-local
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=2048
AI_MAX_CONTEXT_BYTES=24000
AI_CONCURRENCY=1
AI_QUEUE_TIMEOUT_SECONDS=2
AI_SCHEMA_MODE=full
# structural is experimental grammar only; full Pydantic validation always applies.
# For slower CPU inference raise AI_TIMEOUT_SECONDS and GRPC_TIMEOUT_SECONDS together.
# No automatic provider fallback. AI_PROVIDER=gemini is no longer supported.
